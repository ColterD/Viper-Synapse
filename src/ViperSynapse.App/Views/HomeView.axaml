<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViperSynapse.App.ViewModels"
             xmlns:views="using:ViperSynapse.App.Views"
             xmlns:controls="using:ViperSynapse.App.Controls"
             xmlns:devices="using:ViperSynapse.Core.Devices"
             x:Class="ViperSynapse.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <UserControl.Styles>
        <Style Selector="controls|DeviceCardsPanel">
            <Setter Property="Columns" Value="1" />
        </Style>
        <ContainerQuery Name="dashboard" Query="min-width:1180">
            <Style Selector="controls|DeviceCardsPanel">
                <Setter Property="Columns" Value="2" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>
    <Grid Container.Name="dashboard" Container.Sizing="Width">
        <ScrollViewer IsVisible="{Binding ShowDevicesPage}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1280" Margin="28,24" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Name="DevicesHeading" Text="Devices" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                               Focusable="True" IsTabStop="False" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Refresh devices" Command="{Binding RefreshCommand}"
                                IsVisible="{Binding HasScanResult}" />
                        <Button Content="Global shortcuts" Command="{Binding ShowShortcutsCommand}" />
                    </StackPanel>
                </Grid>

                <Border Name="DeviceScanStatus" Classes="deviceStatus" IsVisible="{Binding IsScanning}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Scanning for devices" />
                        <TextBlock Text="Viper is checking for connected Razer devices." TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Width="160" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Scanning for devices" />
                    </StackPanel>
                </Border>

                <Border Name="DeviceServiceError" Classes="deviceStatus" IsVisible="{Binding HasServiceError}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Could not scan for devices" />
                        <TextBlock Text="Viper could not get a device list from its service." TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding ServiceError}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="The list below is from the last successful scan." TextWrapping="Wrap"
                                   IsVisible="{Binding Devices.Count, Converter={x:Static views:Converters.HasItems}}" />
                        <WrapPanel>
                            <Button Name="RetryDeviceScanButton" Content="Retry scan" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                            <Button Classes="link" Content="Device setup and troubleshooting" Click="OpenDeviceSetup" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <Border Name="DeviceSetupHint" Classes="deviceStatus">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="HasScanResult" />
                                <Binding Path="Devices.Count" Converter="{x:Static views:Converters.IsEmpty}" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="No devices detected" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="Connect your Razer device by USB or its wireless receiver, or pair it in Linux Bluetooth settings." />
                            <Button Classes="link" Content="Device setup and troubleshooting" Click="OpenDeviceSetup" />
                        </StackPanel>
                    </Border>
                    <ItemsControl Name="ConnectedDeviceCards" ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:DeviceCardsPanel ColumnSpacing="12" RowSpacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceViewModel">
                                <StackPanel Spacing="6">
                                    <Button Classes="deviceCard" Click="OpenDevice"
                                            AutomationProperties.Name="{Binding ShortName}">
                                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="14">
                                            <Panel Height="52">
                                                <Image Source="{Binding Photo}" Stretch="Uniform"
                                                       IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <Image Source="/Assets/icon.png" Width="36" Height="36"
                                                       IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNull}}" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ShortName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DashboardConnection}" Classes="caption" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ProfileName, StringFormat='Software profile · {0}'}" Classes="caption" TextWrapping="Wrap"
                                                           IsVisible="{Binding ProfileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Data="M0,0 L5,5 L0,10" Stroke="{StaticResource TextDimBrush}"
                                                  StrokeThickness="1.5" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Border Classes="devicePanel statusNotice" Padding="12,10"
                                            IsVisible="{Binding DashboardAttention.Count, Converter={x:Static views:Converters.HasItems}}">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{Binding DashboardAttentionSummary}" Classes="deviceStatusText statusWarning" />
                                            <ItemsControl ItemsSource="{Binding DashboardAttention}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DashboardUnitAttention">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Unit.Label}" Classes="caption" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Reason}" Classes="deviceDetail" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="link" Content="Health" Click="OpenHealth"
                                                                    AutomationProperties.Name="{Binding HealthLabel}"
                                                                    Tag="{Binding $parent[ItemsControl].((vm:DeviceViewModel)DataContext)}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- GLOBAL SHORTCUTS: one card with the list and the dashed ADD A SHORTCUT row; the editor beside it. -->
        <ScrollViewer IsVisible="{Binding ShowShortcutsPage}">
            <StackPanel>
                <Button Content="Back to devices" Command="{Binding ShowDevicesCommand}" Margin="28,20,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="12" Margin="16,14"
                            DataContext="{Binding Shortcuts}" x:DataType="vm:ShortcutsViewModel">
                    <Border Background="#151515" Width="432" Padding="14,16" VerticalAlignment="Top" CornerRadius="2">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="SHORTCUTS" Foreground="{DynamicResource AccentBrush}" FontSize="13" VerticalAlignment="Center" />
                                <Button Name="AddShortcutButton" Grid.Column="1" Classes="flat" Content="+" FontSize="20" FontWeight="Light"
                                        ToolTip.Tip="Add a shortcut" AutomationProperties.Name="Add a shortcut" Click="EditShortcut" />
                            </Grid>
                            <TextBlock Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap"
                                       Text="Global shortcuts work across profiles for devices whose input the app manages." />
                            <StackPanel Spacing="6" IsVisible="{Binding SaveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding CanDiscardFailedSave}">
                                    <Button Content="Retry save" Command="{Binding RetrySaveCommand}" IsVisible="{Binding CanRetryFailedSave}" />
                                    <Button Content="Discard and reload…" Command="{Binding RequestDiscardSaveCommand}" />
                                </WrapPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding IsDiscardConfirmationVisible}">
                                    <TextBlock Text="Discard your unsaved shortcut edits and load the saved shortcuts?" TextWrapping="Wrap" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <Button Content="Keep edits" Command="{Binding CancelDiscardSaveCommand}" />
                                        <Button Content="Discard and reload" Command="{Binding ConfirmDiscardSaveCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShortcutRow">
                                        <Border Background="#1E1E1E" Margin="0,0,0,6" Padding="12,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Keys}" Foreground="#FFFFFF" FontSize="13" />
                                                    <TextBlock Classes="caption">
                                                        <Run Text="{Binding Category}" /><Run Text=":  " /><Run Text="{Binding Function}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="flat shortcutEdit" Content="✎" ToolTip.Tip="Edit"
                                                        AutomationProperties.Name="Edit shortcut" Click="EditShortcut" />
                                                <Button Grid.Column="2" Classes="flat" Content="🗑" ToolTip.Tip="Delete"
                                                        Command="{Binding $parent[ItemsControl].((vm:ShortcutsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Click="EditShortcut" Background="Transparent" Padding="0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" Cursor="Hand" Margin="0,4,0,8">
                                <Panel Height="50">
                                    <Rectangle Stroke="#7A7A7A" StrokeThickness="1" StrokeDashArray="4,3" />
                                    <TextBlock Text="ADD A SHORTCUT" Foreground="#DDDDDD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- The keys, then the function from the key-binding editor (its SAVE stores the shortcut). -->
                    <StackPanel Spacing="8" IsVisible="{Binding Editing}" Width="330">
                        <Border Background="{StaticResource PanelBrush}" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="caption" Text="DEVICE" />
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding EditDevice}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceViewModel">
                                            <TextBlock Text="{Binding ShortName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="caption" Text="KEYS, HELD TOGETHER (TWO OR THREE)" />
                                <ComboBox ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding Key1}" HorizontalAlignment="Stretch" PlaceholderText="First key">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="devices:DeviceKey">
                                            <TextBlock><Run Text="{Binding Number}" /><Run Text="  " /><Run Text="{Binding Label}" /></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding Key2}" HorizontalAlignment="Stretch" PlaceholderText="Second key">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="devices:DeviceKey">
                                            <TextBlock><Run Text="{Binding Number}" /><Run Text="  " /><Run Text="{Binding Label}" /></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding Key3}" HorizontalAlignment="Stretch" PlaceholderText="Third key (optional)">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="devices:DeviceKey">
                                            <TextBlock><Run Text="{Binding Number}" /><Run Text="  " /><Run Text="{Binding Label}" /></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding Problem}" Foreground="#E5484D" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                        <ContentControl Content="{Binding Editor}" IsVisible="{Binding Editing}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:BindingEditorViewModel">
                                    <views:BindingFlyout MaxHeight="420" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
