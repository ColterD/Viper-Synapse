<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ViperSynapse.App.ViewModels"
        xmlns:views="using:ViperSynapse.App.Views"
        xmlns:services="using:ViperSynapse.App.Services"
        x:Class="ViperSynapse.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static services:AppBranding.Name}"
        Icon="/Assets/icon.png"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None">

    <Window.Resources>
        <DataTemplate x:Key="TopTabTemplate" x:DataType="vm:TabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                          Data="{Binding Icon, Converter={x:Static views:Converters.TabIconGeometry}}" />
                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Header}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:DeviceViewModel"><views:DeviceView /></DataTemplate>
        <DataTemplate DataType="vm:LinkedGamesViewModel"><views:LinkedGamesView /></DataTemplate>
        <DataTemplate DataType="vm:MacrosViewModel"><views:MacrosView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <Grid RowDefinitions="Auto,34,*,Auto">
            <!-- Dragging the tab bar moves the window. -->
            <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" Name="TopBar" MinHeight="40">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Classes="chrome" Name="MinimizeButton" ToolTip.Tip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                        </Button>
                        <Button Classes="chrome" Name="MaximizeButton" ToolTip.Tip="Maximize">
                            <Rectangle Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                        </Button>
                        <Button Classes="chrome close" Name="CloseButton" ToolTip.Tip="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
                        </Button>
                    </StackPanel>
                    <ListBox DockPanel.Dock="Left" Name="PrimaryTabsList" Classes="topTabs"
                             ItemsSource="{Binding PrimaryTabs}" SelectedItem="{Binding SelectedPrimaryTab, Mode=TwoWay}"
                             AutomationProperties.Name="App tabs" Margin="6,0,0,0"
                             ItemTemplate="{StaticResource TopTabTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <ListBox Name="DeviceTabsList" Classes="topTabs"
                             ItemsSource="{Binding Home.Devices}" SelectedItem="{Binding SelectedDeviceTab, Mode=TwoWay}"
                             AutomationProperties.Name="Connected device tabs" Margin="12,0,0,0"
                             IsVisible="{Binding Home.Devices.Count, Converter={x:Static views:Converters.HasItems}}"
                             ItemTemplate="{StaticResource TopTabTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Back, forward, refresh; the page title; help. -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Background="{StaticResource PageBrush}">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Spacing="2">
                    <Button Classes="nav" Content="‹" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Back" />
                    <Button Classes="nav" Content="›" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Forward" />
                    <Button Classes="nav" Content="⟳" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" FontSize="16" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="title" Text="{Binding Title}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Classes="nav" Content="?" Name="HelpButton" ToolTip.Tip="Help and documentation"
                            AutomationProperties.Name="Help and documentation" FontWeight="Bold">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="6" MinWidth="240">
                                    <TextBlock Classes="deviceSectionTitle" Text="Help and documentation" />
                                    <HyperlinkButton Content="Documentation library" NavigateUri="{x:Static services:ProjectLinks.Documentation}" />
                                    <HyperlinkButton Content="Getting started" NavigateUri="{x:Static services:ProjectLinks.GettingStarted}" />
                                    <HyperlinkButton Content="Contributor guide" NavigateUri="{x:Static services:ProjectLinks.Development}" />
                                    <Button Content="Copy documentation link" Click="CopyDocumentationLink" />
                                    <SelectableTextBlock Name="HelpLinkStatus" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="2" Content="{Binding SelectedTab}" />

            <Border Grid.Row="3" Background="#3A1214" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Padding="12,6">
                <TextBlock Text="{Binding Problem}" Foreground="#FFB4B4" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- Resize edges: the window draws its own frame, so it offers its own handles. -->
        <Border Name="EdgeLeft" Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" />
        <Border Name="EdgeRight" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
        <Border Name="EdgeBottom" Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" />
        <Border Name="EdgeBottomRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" />
        <Border Name="EdgeBottomLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" />
    </Panel>
</Window>
